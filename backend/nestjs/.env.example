NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://yalla_cash:yalla_cash@localhost:5432/yalla_cash?schema=public

# Comma-separated Flutter/Web origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-character-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
QR_TOKEN_SECRET=replace-with-a-32-random-character-qr-secret
QR_TOKEN_TTL_SECONDS=120
SECRET_PEPPER=replace-with-a-server-side-hmac-pepper

# Development-only OTP: returns the code in the API response and sends no SMS.
# The API refuses to start with OTP_DEV_MODE=true when NODE_ENV=production.
OTP_DEV_MODE=true
OTP_TTL_SECONDS=300
OTP_LENGTH=6

# OTP abuse limits (all per normalized phone number).
# Wrong guesses allowed on one challenge, and across all challenges within the
# window. Requesting a new code never resets the failed-attempt count.
OTP_MAX_ATTEMPTS_PER_CHALLENGE=5
OTP_MAX_FAILED_ATTEMPTS=5
OTP_FAILED_ATTEMPTS_WINDOW_SECONDS=900
# SMS sends: minimum gap between codes, and hourly / daily caps.
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5
OTP_MAX_SENDS_PER_DAY=10

# LinkSyria delivers the OTP SMS (generation/verification stay in this app).
# Required when OTP_DEV_MODE=false. Never expose LINKSYRIA_API_KEY to clients.
LINKSYRIA_API_URL=https://linksyria.online
LINKSYRIA_API_KEY=

# Firebase Admin is used to verify Google/Facebook OAuth identity tokens from Flutter.
# For local development, omit these and the OAuth endpoint will return 503 until configured.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional seed credentials for local development.
# The seed only runs against a localhost DATABASE_URL. Seeding any other host
# needs ALLOW_REMOTE_SEED=true plus both SEED_*_PASSWORD values; NODE_ENV=production
# additionally needs ALLOW_PRODUCTION_SEED=true. The seed resets these passwords.
SEED_ADMIN_EMAIL=admin@yallacash.app
SEED_ADMIN_PASSWORD=admin123
SEED_MERCHANT_EMAIL=wasim@yallacash.app
SEED_MERCHANT_PASSWORD=123456
