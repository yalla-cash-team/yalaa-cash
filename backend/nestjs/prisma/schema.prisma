generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  MERCHANT
  ADMIN
}

enum AuthMethod {
  PHONE
  GOOGLE
  FACEBOOK
}

enum CashRequestStatus {
  PENDING
  SETTLED
  REJECTED
}

enum RedemptionStatus {
  PENDING
  FULFILLED
  REJECTED
}

enum SettlementStatus {
  OPEN
  SETTLED
}

enum SettlementKind {
  CYCLE
  MONTHLY
}

enum PointsEntryType {
  INVOICE_EARN
  CASH_RESERVE
  CASH_RELEASE
  CASH_SETTLE
  PRODUCT_RESERVE
  PRODUCT_RELEASE
  PRODUCT_REDEEM
  ADMIN_GRANT
  ADMIN_DEDUCT
  SHARE_REWARD
  POINT_CONVERSION
}

enum BannerPlacement {
  HOME
}

enum BannerStyle {
  PROMO
  FEATURE
  HIGHLIGHT
}

model User {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  role          UserRole
  email         String?      @unique
  phone         String?      @unique
  passwordHash  String?
  authMethod    AuthMethod?
  oauthProvider AuthMethod?
  oauthSubject  String?
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  customer        CustomerProfile?
  merchantAccount MerchantAccount?
  adminProfile    AdminProfile?
  otpChallenges   OtpChallenge[]
  refreshTokens   RefreshToken[]
  deviceTokens    DeviceToken[]

  @@unique([oauthProvider, oauthSubject])
  @@index([role])
}

model DeviceToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

enum BroadcastStatus {
  PENDING
  SENT
  PARTIAL
  FAILED
}

/// History of admin push broadcasts. The unique idempotencyKey makes a retried
/// or double-tapped send return the original record instead of sending again.
model NotificationBroadcast {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  idempotencyKey     String          @unique
  title              String
  body               String
  status             BroadcastStatus @default(PENDING)
  recipientCount     Int             @default(0)
  sentCount          Int             @default(0)
  failedCount        Int             @default(0)
  staleTokensRemoved Int             @default(0)
  errorMessage       String?
  createdByUserId    String          @db.Uuid
  createdAt          DateTime        @default(now())
  completedAt        DateTime?

  @@index([status, createdAt])
  @@index([createdAt])
}

model CustomerProfile {
  userId        String   @id @db.Uuid
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  governorate   String
  governorateId String?  @db.Uuid
  pointsBalance BigInt   @default(0)
  /// Earned SYP not yet converted into whole points; carried into the next reward.
  pointRemainderSyp Decimal @default(0) @db.Decimal(12, 4)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  governorateRecord Governorate? @relation(fields: [governorateId], references: [id], onDelete: SetNull)

  transactions           LoyaltyTransaction[]
  shareRewardClaim       ShareRewardClaim?
  pointsLedger           PointsLedgerEntry[]
  productRedemptions     ProductRedemption[]
  cashRedemptionRequests CashRedemptionRequest[]

  @@index([governorate])
  @@index([governorateId])
}

model Governorate {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nameAr       String   @unique
  isActive     Boolean  @default(false)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customers CustomerProfile[]
  banners   Banner[]
  stores    Store[]

  @@index([isActive, displayOrder])
}

/// Uploaded banner image bytes (same storage approach as store logos).
model BannerImage {
  bannerId    String   @id @db.Uuid
  banner      Banner   @relation(fields: [bannerId], references: [id], onDelete: Cascade)
  contentType String
  data        Bytes
  updatedAt   DateTime @updatedAt
}

model Banner {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title        String
  subtitle     String?
  imageUrl     String
  /// Bumped on every banner image upload or removal (cache-busting).
  imageVersion Int             @default(0)
  image        BannerImage?
  targetUrl    String?
  placement    BannerPlacement @default(HOME)
  style        BannerStyle     @default(PROMO)
  isActive     Boolean         @default(true)
  displayOrder Int             @default(0)
  startsAt     DateTime?
  endsAt       DateTime?
  governorateId String?         @db.Uuid
  governorate  Governorate?    @relation(fields: [governorateId], references: [id], onDelete: SetNull)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([placement, isActive, displayOrder])
  @@index([governorateId, placement, isActive])
}

model Store {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  category       String
  city           String
  commissionRate Decimal  @db.Decimal(5, 2)
  description    String   @default("")
  location       String   @default("")
  imageUrl       String?
  iconSeed       Int      @default(0)
  /// Bumped on every logo upload or removal; used to cache-bust logo URLs.
  logoVersion    Int      @default(0)
  isActive       Boolean  @default(true)
  governorateId  String   @db.Uuid
  governorate    Governorate @relation(fields: [governorateId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  merchantAccounts MerchantAccount[]
  transactions     LoyaltyTransaction[]
  settlements      MerchantSettlement[]
  logo             StoreLogo?

  @@index([city, category])
  @@index([isActive])
  @@index([governorateId, isActive])
}

/// Store logo image bytes, kept out of the Store row so store lists stay light.
model StoreLogo {
  storeId     String   @id @db.Uuid
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  contentType String
  data        Bytes
  updatedAt   DateTime @updatedAt
}

/// One row per customer account that has claimed the share reward. The
/// primary key makes a second claim fail, so the reward is granted once.
model ShareRewardClaim {
  customerId    String          @id @db.Uuid
  customer      CustomerProfile @relation(fields: [customerId], references: [userId], onDelete: Cascade)
  pointsAwarded BigInt
  createdAt     DateTime        @default(now())
}

model MerchantAccount {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @unique @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeId      String   @db.Uuid
  store        Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  displayLabel String   @default("Primary account")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  devices      MerchantDevice[]
  transactions LoyaltyTransaction[]

  @@index([storeId])
}

model MerchantDevice {
  id                    String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantAccountId     String          @db.Uuid
  merchantAccount       MerchantAccount @relation(fields: [merchantAccountId], references: [id], onDelete: Cascade)
  deviceLabel           String
  deviceFingerprintHash String
  lastLoginAt           DateTime        @default(now())
  createdAt             DateTime        @default(now())

  @@unique([merchantAccountId, deviceFingerprintHash])
}

model AdminProfile {
  userId      String   @id @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PlatformSettings {
  id            Int      @id @default(1)
  pointValueSyp Decimal  @db.Decimal(12, 4)
  /// Smallest cash payout allowed. 0 means no minimum. Not enforced yet.
  minCashWithdrawalSyp BigInt @default(0)
  /// Points awarded once per customer for sharing the app. 0 disables it.
  shareRewardPoints    BigInt @default(0)
  updatedAt     DateTime @updatedAt
}

model LoyaltyTransaction {
  id                     String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId                String          @db.Uuid
  store                  Store           @relation(fields: [storeId], references: [id])
  customerId             String          @db.Uuid
  customer               CustomerProfile @relation(fields: [customerId], references: [userId])
  merchantAccountId      String          @db.Uuid
  merchantAccount        MerchantAccount @relation(fields: [merchantAccountId], references: [id])
  amountSyp              BigInt
  commissionRateSnapshot Decimal         @db.Decimal(5, 2)
  commissionAmountSyp    BigInt
  platformRevenueSyp     BigInt
  customerShareSyp       BigInt
  pointValueSypSnapshot  Decimal         @db.Decimal(12, 4)
  customerPointsEarned   BigInt
  idempotencyKey         String          @unique @db.Uuid
  createdAt              DateTime        @default(now())

  pointsLedger PointsLedgerEntry[]

  @@index([customerId, createdAt])
  @@index([storeId, createdAt])
  @@index([merchantAccountId, createdAt])
}

model PointsLedgerEntry {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId    String              @db.Uuid
  customer      CustomerProfile     @relation(fields: [customerId], references: [userId], onDelete: Cascade)
  entryType     PointsEntryType
  pointsDelta   BigInt
  balanceAfter  BigInt
  transactionId String?             @db.Uuid
  transaction   LoyaltyTransaction? @relation(fields: [transactionId], references: [id])
  referenceId   String?             @db.Uuid
  note          String?
  createdAt     DateTime            @default(now())

  @@index([customerId, createdAt])
}

model DigitalProduct {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String
  costInPoints        BigInt
  imageUrl            String?
  /// Bumped on every image upload or removal; used to cache-bust the image URL.
  imageVersion        Int      @default(0)
  iconSeed            Int      @default(0)
  requiresPhoneNumber Boolean  @default(false)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  redemptions ProductRedemption[]
  image       DigitalProductImage?

  @@index([isActive])
}

/// Digital product image bytes, kept out of the DigitalProduct row so the
/// product list stays light.
model DigitalProductImage {
  productId   String         @id @db.Uuid
  product     DigitalProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  contentType String
  data        Bytes
  updatedAt   DateTime       @updatedAt
}

model ProductRedemption {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId         String           @db.Uuid
  customer           CustomerProfile  @relation(fields: [customerId], references: [userId])
  productId          String           @db.Uuid
  product            DigitalProduct   @relation(fields: [productId], references: [id])
  pointsCostSnapshot BigInt
  phoneNumber        String?
  status             RedemptionStatus @default(PENDING)
  fulfilledAt        DateTime?
  createdAt          DateTime         @default(now())

  @@index([customerId, createdAt])
  @@index([productId])
}

model CashRedemptionRequest {
  id                    String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId            String            @db.Uuid
  customer              CustomerProfile   @relation(fields: [customerId], references: [userId])
  pointsRequested       BigInt
  pointValueSypSnapshot Decimal           @db.Decimal(12, 4)
  cashValueSyp          BigInt
  status                CashRequestStatus @default(PENDING)
  settledByUserId       String?           @db.Uuid
  settledAt             DateTime?
  createdAt             DateTime          @default(now())

  @@index([customerId, status])
  @@index([status, createdAt])
}

model MerchantSettlement {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId          String           @db.Uuid
  store            Store            @relation(fields: [storeId], references: [id])
  periodStart      DateTime
  periodEnd        DateTime
  transactionCount Int              @default(0)
  totalSalesSyp    BigInt           @default(0)
  commissionDueSyp BigInt           @default(0)
  status           SettlementStatus @default(OPEN)
  settledByUserId  String?          @db.Uuid
  settledAt        DateTime?
  /// CYCLE: per-merchant settlement since the last cycle. MONTHLY: one calendar
  /// month, settled in bulk. Only CYCLE rows move the cycle boundary.
  kind             SettlementKind  @default(CYCLE)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([storeId, periodStart, periodEnd])
  @@index([periodStart, periodEnd])
}

model OtpChallenge {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String?   @db.Uuid
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone      String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}
